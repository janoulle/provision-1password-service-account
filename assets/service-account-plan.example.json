{
  "schema_version": 1,
  "vault": {
    "name": "Example Application Production",
    "description": "Credentials required by the Example Application production runtime"
  },
  "service_account": {
    "name": "example-application-provisioner",
    "permissions": ["read_items"],
    "expires_in": null
  },
  "items": [
    {
      "title": "Example Application - Provider API credential",
      "source_vault": "Private"
    }
  ],
  "token_storage": {
    "recovery_vault": "Private",
    "recovery_item_title": "Example Application - 1Password service account token",
    "keychain_service": "com.example.application.1password-service-account",
    "keychain_account": "example-application-provisioner"
  }
}
